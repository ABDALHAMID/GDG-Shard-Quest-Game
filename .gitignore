# They also could contain extremely sensitive data
GDG Shard Quest Game/[Mm]emoryCaptures/

# Recordings can get excessive in size
GDG Shard Quest Game/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# GDG Shard Quest Game/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
GDG Shard Quest Game/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
GDG Shard Quest Game/ExportedObj/
GDG Shard Quest Game/.consulo/
GDG Shard Quest Game/*.csproj
GDG Shard Quest Game/*.unityproj
GDG Shard Quest Game/*.sln
GDG Shard Quest Game/*.suo
GDG Shard Quest Game/*.tmp
GDG Shard Quest Game/*.user
GDG Shard Quest Game/*.userprefs
