GDG Shard Quest Game/*.pdb.meta
GDG Shard Quest Game/*.mdb.meta

# Unity3D generated file on crash reports
GDG Shard Quest Game/sysinfo.txt

# Builds
GDG Shard Quest Game/*.apk
GDG Shard Quest Game/*.aab
GDG Shard Quest Game/*.unitypackage
GDG Shard Quest Game/*.unitypackage.meta
GDG Shard Quest Game/*.app

